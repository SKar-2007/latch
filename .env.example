# Copy to `.env` and fill in. `.env` is gitignored; this template is not, so it stays safe to commit.
#
#   cp .env.example .env
#
# `.env` is read by Foundry for every `forge` invocation, so it must sit in the repository root.

# ---------------------------------------------------------------------------------------------
# Deployer key
# ---------------------------------------------------------------------------------------------
# A key for an address you have funded with Base Sepolia ETH. Testnet only -- never a key that has
# touched mainnet.
#
# Generate one with:
#   cast wallet new --mnemonic
#
# `script/Deploy.s.sol` reads this as `DEPLOYER_KEY`. It is the only secret the project needs.
DEPLOYER_KEY=

# ---------------------------------------------------------------------------------------------
# RPC
# ---------------------------------------------------------------------------------------------
# A public endpoint is enough. It is only used to broadcast and to confirm, never as a secret.
#
#   https://sepolia.base.org                          public, no key, rate limited
#   https://base-sepolia.g.alchemy.com/v2/<key>       higher rate limits
#
# Note: `foundry.toml` interpolates this into the `base_sepolia` RPC alias.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ---------------------------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------------------------
# Only needed to run `web/`. Every one of these may be empty, which renders as `not configured`
# rather than substituting a plausible address.
#
#   VITE_RPC_PRIMARY     must be set. Anything feeding a bound must come from this endpoint
#   VITE_RPC_SECONDARY   optional. Reads may fail over to it; writes may not
#   VITE_RPC_TERTIARY    optional. Same rule
#
# LATCH-owned deployments. Leave empty until they exist; the UI says `not configured` on purpose.
VITE_RPC_PRIMARY=https://sepolia.base.org
VITE_RPC_SECONDARY=
VITE_RPC_TERTIARY=

VITE_FEED_GUARD=
VITE_QUOTER_GUARD=
VITE_FAILSAFE=